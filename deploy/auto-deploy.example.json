{
  "live": "/srv/agent-fleet",
  "state": "/var/lib/agent-fleet-deploy",
  "frontend_root": "/var/www/agent-fleet",
  "nginx_config": "/etc/nginx/sites-enabled/fleet.example.com",
  "maintenance_marker": "/srv/hermes-data/agent-fleet-account-maintenance",
  "container": "fleet-runtime",
  "container_user": "fleet",
  "container_live": "/srv/agent-fleet",
